formulas:
  Category: file.folder.split('/')[2]
properties:
  note.thinking_tool_type:
    displayName: Tool Type
views:
  - type: table
    name: All Tools
    filters:
      and:
        - file.path.contains("Intuition Pumps and Other Tools for Thinking - Dennett, Daniel C")
        - "!thinking_tool_type.isEmpty()"
    groupBy:
      property: formula.Category
      direction: ASC
    order:
      - file.name
      - thinking_tool_type
  - type: cards
    name: Tools
    filters:
      and:
        - file.path.contains("Intuition Pumps and Other Tools for Thinking - Dennett, Daniel C")
        - thinking_tool_type == "tool"
    order:
      - file.name
      - formula.Category
  - type: cards
    name: Intuition Pumps
    filters:
      and:
        - file.path.contains("Intuition Pumps and Other Tools for Thinking - Dennett, Daniel C")
        - thinking_tool_type == "intuition pump"
    order:
      - file.name
      - formula.Category
  - type: cards
    name: Antitools
    filters:
      and:
        - file.path.contains("Intuition Pumps and Other Tools for Thinking - Dennett, Daniel C")
        - thinking_tool_type == "antitool"
    order:
      - file.name
      - formula.Category
